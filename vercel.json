{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node", "config": { "includeFiles": ["server/fonts/**", "swagger.yaml", "frontend/*.html"] } },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/api-docs(.*)", "dest": "/api/index.js" },
    { "src": "/login/?", "dest": "/frontend/login.html" },
    { "src": "/(manager|customer)/?", "dest": "/frontend/dashboard.html" },
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
