# Supabase project configured with the included migration and email/password Auth.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# No service-role secret is needed in this application.
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PORT=3000
# Explicitly simulated payments only. Also enable the database setting as documented.
# Connected reservations also require this flag and the 20261020 checkout migration.
ENABLE_TEST_PAYMENTS=false
# Displayed on generated invoices. Configure your real issuer details before use.
INVOICE_ISSUER=GridSync
INVOICE_ISSUER_ADDRESS=
