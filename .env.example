# Supabase credentials (find these in your Supabase project → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Comma-separated list of frontend origins allowed to call the API
# In production, set this to your Vercel deployment URL, e.g.:
# ALLOWED_ORIGINS=https://smart-ev-dbms.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Only needed when running locally (Vercel sets PORT automatically)
PORT=3000
